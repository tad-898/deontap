@model IEnumerable<DangAnhTu_241224493.Models.TaiSan>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="section-head">
    <h3 id="section-title">Đặng Anh Tú</h3>
    <a asp-controller="Home" asp-action="Create" class="btn-buy" style="color:#fff;">+ Thêm tài sản mới</a>
</div>

<div id="asset-list-container">
    <partial name="_DanhSachTaiSan" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.menu-item').on('click', function (e) {
                var maLoai = $(this).data('id');
                // Bấm vào menu tên sinh viên (data-id="0") thì chuyển về trang chủ mặc định
                if (maLoai === 0) return;

                e.preventDefault();
                var tenLoai = $(this).data('name');

                $('.menu li').removeClass('active');
                $(this).parent('li').addClass('active');

                $('#section-title').text(tenLoai);

                $.ajax({
                    url: '@Url.Action("LocTaiSanTheoLoai", "Home")',
                    type: 'GET',
                    data: { maLoai: maLoai },
                    success: function (result) {
                        $('#asset-list-container').html(result);
                    },
                    error: function () {
                        alert('Lỗi khi tải dữ liệu theo loại tài sản!');
                    }
                });
            });
        });
    </script>
}