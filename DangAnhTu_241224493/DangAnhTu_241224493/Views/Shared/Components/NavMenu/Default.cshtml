@model IEnumerable<DangAnhTu_241224493.Models.TheLoai>

<nav class="navbar">
    <div class="container">
        <ul class="menu">
            <li class="active">
                <a href="@Url.Action("Index", "Home")"
                   class="nav-filter active"
                   data-id="0"
                   data-name="ĐẶNG ANH TÚ">
                    ĐẶNG ANH TÚ
                </a>
            </li>
            @foreach (var tl in Model)
            {
                <li>
                    <a href="@Url.Action("Index", "Home", new { id = tl.MaTl, categoryName = tl.TenTl })"
                       class="nav-filter"
                       data-id="@tl.MaTl"
                       data-name="@tl.TenTl">
                        @tl.TenTl.ToUpper()
                    </a>
                </li>
            }
            <li>
                <a asp-controller="Home" asp-action="Create">
                    THÊM SÁCH
                </a>
            </li>
        </ul>

        <div class="search-box">
            <input type="text" placeholder="Tìm sách..." />
            <button type="button">Tìm</button>
        </div>
    </div>
</nav>