@model IEnumerable<DangAnhTu_241224493.Models.TaiSan>

<div class="grid">
    @foreach (var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@item.Anh" alt="@item.TenTs" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@item.NguyenGia tr</span>
                <button type="button" class="btn-buy">Chi tiết</button>
            </div>
        </div>
    }
</div>