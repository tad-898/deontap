@model DangAnhTu_241224493.Models.TaiSan

@{
    ViewData["Title"] = "Thêm tài sản mới";
}

<style>
    .form-card {
        max-width: 620px;
        margin: 25px auto;
        background: #fff;
        padding: 28px 34px;
        border-radius: 8px;
        box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
    }
    .form-card h3 {
        color: #1d3f72;
        font-size: 19px;
        text-transform: uppercase;
        margin-bottom: 22px;
    }
    .form-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: 16px;
    }
    .form-row label {
        width: 160px;
        padding-top: 8px;
        font-weight: 600;
        font-size: 14px;
        color: #2b3a42;
    }
    .form-input-wrap {
        flex: 1;
    }
    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #c5d3d8;
        border-radius: 4px;
        font-size: 14px;
        outline: none;
    }
    .form-control:focus {
        border-color: #1d3f72;
    }
    .text-danger {
        display: block;
        color: #c9302c;
        font-size: 12px;
        margin-top: 4px;
    }
</style>

<div class="form-card">
    <h3>THÊM TÀI SẢN MỚI</h3>
    <form asp-action="Create" method="post">
        <div class="form-row">
            <label asp-for="MaLoai"></label>
            <div class="form-input-wrap">
                <select asp-for="MaLoai" class="form-control" asp-items="ViewBag.MaLoai"></select>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="TenTs"></label>
            <div class="form-input-wrap">
                <input asp-for="TenTs" class="form-control" />
                <span asp-validation-for="TenTs" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="NguyenGia"></label>
            <div class="form-input-wrap">
                <input asp-for="NguyenGia" class="form-control" />
                <span asp-validation-for="NguyenGia" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Anh"></label>
            <div class="form-input-wrap">
                <input asp-for="Anh" class="form-control" />
                <span asp-validation-for="Anh" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label></label>
            <div class="form-input-wrap">
                <button type="submit" class="btn-buy">Create</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}