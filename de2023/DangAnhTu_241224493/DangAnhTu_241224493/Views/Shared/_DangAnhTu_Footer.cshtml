<script>
    $(document).ready(function () {
        $(document).on("click", ".nav-filter", function (e) {
            var $container = $("#book-section-container");

            
            if ($container.length > 0) {
                e.preventDefault();

                var categoryId = $(this).data("id");
                var categoryName = $(this).data("name");

                $(".menu li").removeClass("active");
                $(this).closest("li").addClass("active");

                $.ajax({
                    url: '@Url.Action("FilterByCategory", "Home")',
                    type: 'GET',
                    data: { id: categoryId, categoryName: categoryName },
                    success: function (result) {
                        $container.html(result);
                    },
                    error: function () {
                        alert("Không thể tải danh sách sách theo thể loại.");
                    }
                });
            }
        });
    });
</script>
